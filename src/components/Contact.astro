---
import { person, site } from '../data/profile';
import Icon from './Icon.astro';
---
<section id="contact" class="section section--alt" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Contact</span>
      <h2 id="contact-title" class="section-title">Get in touch</h2>
      <p class="lead">I’m looking for Android, mobile and on-device AI engineering roles. Email is the best way to reach me.</p>
    </div>
    <ul class="list">
      <li>
        <span class="ico"><Icon name="mail" /></span>
        <div><p class="k">Email</p><a href={`mailto:${person.email}`}>{person.email}</a></div>
      </li>
      <li>
        <span class="ico"><Icon name="linkedin" /></span>
        <div>
          <p class="k">LinkedIn</p>
          <a href={person.linkedin} rel="noopener noreferrer" target="_blank">{person.linkedinLabel}<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
      </li>
      <li>
        <span class="ico"><Icon name="github" /></span>
        <div>
          <p class="k">GitHub</p>
          <a href={person.github} rel="noopener noreferrer" target="_blank">{person.githubLabel}<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
      </li>
      <li>
        <span class="ico"><Icon name="pin" /></span>
        <div>
          <p class="k">Location</p>
          <p>{person.location}. {person.relocation}.</p>
          <p class="muted">{person.rightToWork}</p>
        </div>
      </li>
    </ul>
    <a class="btn btn--primary cv" href={site.cvFile} download>
      <Icon name="download" /> Download CV <span class="visually-hidden">(PDF)</span>
    </a>
  </div>
</section>

<style>
  .list {
    list-style: none;
    display: grid;
    gap: 1.1rem;
  }
  @media (min-width: 760px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 2.5rem;
    }
  }
  li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    min-width: 0;
  }
  li div {
    min-width: 0;
  }
  .ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .k {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cv {
    margin-top: 2.25rem;
  }
</style>
