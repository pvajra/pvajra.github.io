---
import { person, site } from '../data/profile';
---
<section id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">Contact</h2>
    <p>I’m looking for Android, mobile and on-device AI engineering roles. The best way to reach me is by email.</p>
    <ul class="contact">
      <li><span class="k">Email</span> <a href={`mailto:${person.email}`}>{person.email}</a></li>
      <li><span class="k">LinkedIn</span> <a href={person.linkedin} rel="noopener noreferrer">{person.linkedinLabel}</a></li>
      <li><span class="k">GitHub</span> <a href={person.github} rel="noopener noreferrer">{person.githubLabel}</a></li>
      <li><span class="k">Location</span> {person.location}. {person.relocation}.</li>
      <li><span class="k">Right to work</span> {person.rightToWork}</li>
      <li><span class="k">CV</span> <a href={site.cvFile} download>Download (PDF)</a></li>
    </ul>
  </div>
</section>

<style>
  .contact {
    list-style: none;
    padding: 0;
  }
  .contact li {
    display: grid;
    gap: 0 1.5rem;
    margin-bottom: 0.5rem;
    overflow-wrap: anywhere;
  }
  @media (min-width: 600px) {
    .contact li {
      grid-template-columns: 8rem 1fr;
    }
  }
  .k {
    color: var(--muted);
  }
</style>
