---
import { experience } from '../data/profile';
---
<section id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <h2 id="experience-title">Experience</h2>
    <ol class="timeline">
      {experience.map((role) => (
        <li class="role">
          <p class="when"><time>{role.start}</time> – <time>{role.end}</time></p>
          <div>
            <h3>{role.title}</h3>
            <p class="where">{role.company}, {role.location}</p>
            <p>{role.summary}</p>
            <ul>
              {role.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {role.tech && <p class="small muted">{role.tech.join(', ')}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    margin: 0 0 2.25rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--rule);
  }
  .role:first-child {
    border-left-color: var(--accent);
  }
  .role ul {
    list-style: disc;
  }
  .when {
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
    font-variant-numeric: tabular-nums;
  }
  .where {
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
</style>
