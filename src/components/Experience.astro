---
import { experience } from '../data/profile';
---
<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Experience</span>
      <h2 id="experience-title" class="section-title">Where I’ve worked</h2>
      <p class="lead">Select a role to see what I did there.</p>
    </div>

    <ol class="timeline">
      {experience.map((role, i) => (
        <li class="item">
          <span class="dot" aria-hidden="true"></span>
          <details class="card role" open={i === 0}>
            <summary>
              <div class="summary-main">
                <h3>{role.title}</h3>
                <p class="company">{role.company} · {role.location}</p>
              </div>
              <p class="dates"><time>{role.start}</time> – <time>{role.end}</time></p>
              <span class="chev" aria-hidden="true"></span>
            </summary>
            <div class="body">
              <p class="role-summary">{role.summary}</p>
              <ul class="bullets">
                {role.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {role.tech && (
                <ul class="chips chips--small" aria-label="Technologies">
                  {role.tech.map((t) => <li class="chip">{t}</li>)}
                </ul>
              )}
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    position: relative;
    display: grid;
    gap: 1rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.4rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--border);
  }
  .item {
    position: relative;
  }
  .dot {
    position: absolute;
    left: -1.5rem;
    top: 1.35rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent);
    transform: translateX(-0.05rem);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    border-radius: var(--radius);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .summary-main {
    grid-column: 1 / 2;
  }
  h3 {
    font-size: 1.05rem;
  }
  .company {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 0.2rem;
  }
  .dates {
    grid-column: 1 / 2;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .chev {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    width: 0.65rem;
    height: 0.65rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }
  details[open] .chev {
    transform: rotate(-135deg);
  }
  @media (min-width: 700px) {
    summary {
      grid-template-columns: 1fr auto auto;
      align-items: center;
    }
    .dates {
      grid-column: 2;
      grid-row: 1;
    }
    .chev {
      grid-column: 3;
      grid-row: 1;
    }
  }
  .body {
    display: grid;
    gap: 1rem;
    padding: 0 1.25rem 1.25rem;
  }
  .role-summary {
    color: var(--muted);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
</style>
