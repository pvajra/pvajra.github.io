---
import { education } from '../data/profile';
---
<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Education</span>
      <h2 id="education-title" class="section-title">Education</h2>
    </div>
    <ul class="grid">
      {education.map((e) => (
        <li class="card edu">
          <p class="dates"><time>{e.start}</time> – <time>{e.end}</time></p>
          <h3>{e.degree}</h3>
          {e.result && <p class="badge">{e.result}</p>}
          <p class="school">{e.school}, {e.location}</p>
          {e.note && <p class="note">{e.note}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .edu {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.4rem;
  }
  .dates {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
  }
  h3 {
    font-size: 1.1rem;
  }
  .badge {
    justify-self: start;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .school {
    font-weight: 500;
  }
  .note {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
