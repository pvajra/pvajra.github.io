---
import { education } from '../data/profile';
---
<section id="education" aria-labelledby="education-title">
  <div class="wrap">
    <h2 id="education-title">Education</h2>
    {education.map((e) => (
      <div class="edu">
        <h3>{e.degree}{e.result && <span>, {e.result}</span>}</h3>
        <p class="muted">{e.school}, {e.location} · {e.start} – {e.end}</p>
        {e.note && <p>{e.note}</p>}
      </div>
    ))}
  </div>
</section>

<style>
  .edu {
    margin-bottom: 1.5rem;
  }
  .edu p {
    margin-bottom: 0.3rem;
  }
</style>
