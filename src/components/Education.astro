---
import { education } from '../data/profile';
---
<section id="education" aria-labelledby="education-title">
  <h2 id="education-title">Education</h2>
  <ol class="list">
    {education.map((e) => (
      <li class="edu">
        <p class="when">{e.start} – {e.end}</p>
        <div>
          <h3>{e.degree}{e.result && <span class="result"> · {e.result}</span>}</h3>
          <p class="muted">{e.school}, {e.location}</p>
          {e.note && <p>{e.note}</p>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .edu {
    display: grid;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 700px) {
    .edu {
      grid-template-columns: 9.75rem 1fr;
    }
  }
  .when {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .edu p {
    margin-bottom: 0.25rem;
  }
  .result {
    color: var(--accent);
  }
</style>
