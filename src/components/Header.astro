---
import { nav, person } from '../data/profile';
---
<header class="wrap site-header">
  <a class="name" href="#top">{person.name}</a>
  <nav aria-label="Sections">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><button class="theme" type="button" aria-pressed="false">Dark mode</button></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1rem;
    font-size: 0.92rem;
  }
  .name {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    margin: 0;
    padding: 0;
  }
  li {
    margin: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .theme {
    font: inherit;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline dotted;
    text-underline-offset: 0.2em;
  }
  .theme:hover {
    color: var(--text);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme');
  const root = document.documentElement;
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    if (!btn) return;
    btn.textContent = dark ? 'Light mode' : 'Dark mode';
    btn.setAttribute('aria-pressed', String(dark));
  };
  sync();
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>
