---
import { about } from '../data/profile';
import Icon from './Icon.astro';
---
<section id="about" class="section section--alt" aria-labelledby="about-title">
  <div class="container grid">
    <div>
      <span class="eyebrow">About</span>
      <h2 id="about-title" class="section-title">About me</h2>
      <div class="bio">
        {about.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <ul class="highlights">
      {about.highlights.map((h) => (
        <li class="card highlight">
          <span class="tick"><Icon name="check" /></span>
          <div>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .bio {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .highlights {
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 560px) and (max-width: 899px) {
    .highlights {
      grid-template-columns: 1fr 1fr;
    }
  }
  .highlight {
    display: flex;
    gap: 0.85rem;
    padding: 1.1rem 1.2rem;
  }
  .tick {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }
  .highlight p {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
