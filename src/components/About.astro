---
import { about } from '../data/profile';
---
<section id="about" aria-labelledby="about-title">
  <h2 id="about-title">About</h2>
  {about.bio.map((p) => <p>{p}</p>)}
  <ul class="highlights">
    {about.highlights.map((h) => (
      <li>
        <h3>{h.title}</h3>
        <p>{h.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .highlights {
    list-style: none;
    padding: 0;
    margin: 2rem 0 1rem;
    display: grid;
    gap: 1.5rem 2rem;
  }
  @media (min-width: 640px) {
    .highlights {
      grid-template-columns: 1fr 1fr;
    }
  }
  .highlights li {
    margin: 0;
    padding-top: 0.9rem;
    border-top: 2px solid var(--accent);
  }
  .highlights h3 {
    font-size: 0.98rem;
    margin-bottom: 0.3rem;
  }
  .highlights p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--muted);
  }
</style>
