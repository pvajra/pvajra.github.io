---
import { about } from '../data/profile';
---
<section id="about" aria-labelledby="about-title">
  <div class="wrap">
    <h2 id="about-title">About</h2>
    {about.bio.map((p) => <p>{p}</p>)}
    <ul class="highlights">
      {about.highlights.map((h) => <li><strong>{h.title}.</strong> {h.text}</li>)}
    </ul>
  </div>
</section>

<style>
  .highlights {
    margin-top: 1.5rem;
  }
  .highlights li {
    margin-bottom: 0.6rem;
  }
</style>
