---
import { person, site } from '../data/profile';
---
<div id="top" class="wrap hero">
  <h1>{person.name}</h1>
  <p class="headline">{person.headline}</p>
  <p class="intro">{person.tagline}</p>
  <p class="links">
    <a class="cv" href={site.cvFile} download>Download CV <span class="muted">(PDF)</span></a>
    <a href={person.linkedin} rel="noopener noreferrer">LinkedIn</a>
    <a href={person.github} rel="noopener noreferrer">GitHub</a>
    <a href={`mailto:${person.email}`}>Email</a>
  </p>
</div>

<style>
  .hero {
    padding-top: 3.5rem;
    padding-bottom: 3rem;
  }
  h1 {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.6rem);
    letter-spacing: -0.025em;
    margin: 0 0 0.4rem;
  }
  .headline {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .intro {
    font-size: 1.15rem;
    max-width: 36rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.75rem;
  }
  .cv {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 550;
  }
  .cv:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .cv:hover .muted {
    color: inherit;
  }
</style>
