---
import { person, site, metrics, codeCard } from '../data/profile';
import Icon from './Icon.astro';

const list = (items: string[]) => items.map((i) => `"${i}"`).join(', ');
---
<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="intro">
      <p class="status"><span class="pulse" aria-hidden="true"></span>{person.status}</p>
      <h1 id="hero-title">{person.name}</h1>
      <p class="headline">{person.headline}</p>
      <p class="tagline">{person.tagline}</p>
      <div class="actions">
        <a class="btn btn--primary" href={site.cvFile} download>
          <Icon name="download" /> Download CV <span class="visually-hidden">(PDF)</span>
        </a>
        <a class="btn" href={`mailto:${person.email}`}>
          <Icon name="mail" /> Email
        </a>
        <a class="btn btn--icon" href={person.linkedin} rel="noopener noreferrer" target="_blank" aria-label="LinkedIn (opens in a new tab)">
          <Icon name="linkedin" /><span class="lbl">LinkedIn</span>
        </a>
        <a class="btn btn--icon" href={person.github} rel="noopener noreferrer" target="_blank" aria-label="GitHub (opens in a new tab)">
          <Icon name="github" /><span class="lbl">GitHub</span>
        </a>
      </div>
      <p class="loc"><Icon name="pin" /> {person.location}</p>
    </div>

    <figure class="ide" aria-label="Profile summary written as a Kotlin data class">
      <div class="ide-bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="tab">{codeCard.fileName}</span>
      </div>
      <pre class="code"><code><span class="ln">1</span><span class="kw">data class</span> <span class="ty">Engineer</span>(
<span class="ln">2</span>    <span class="kw">val</span> name: <span class="ty">String</span> = <span class="st">"{person.name}"</span>,
<span class="ln">3</span>    <span class="kw">val</span> role: <span class="ty">String</span> = <span class="st">"Android Software Engineer"</span>,
<span class="ln">4</span>    <span class="kw">val</span> stack: <span class="ty">List</span>&lt;<span class="ty">String</span>&gt; = <span class="fn">listOf</span>(
<span class="ln">5</span>        <span class="st">{list(codeCard.stack)}</span>
<span class="ln">6</span>    ),
<span class="ln">7</span>    <span class="kw">val</span> focus: <span class="ty">List</span>&lt;<span class="ty">String</span>&gt; = <span class="fn">listOf</span>(
<span class="ln">8</span>        <span class="st">{list(codeCard.focus)}</span>
<span class="ln">9</span>    ),
<span class="ln">10</span>    <span class="kw">val</span> openToWork: <span class="ty">Boolean</span> = <span class="kw">true</span>,
<span class="ln">11</span>)</code></pre>
    </figure>
  </div>

  <div class="container">
    <ul class="metrics" aria-label="Key numbers">
      {metrics.map((m) => (
        <li>
          <p class="m-value">{m.value}</p>
          <p class="m-label">{m.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 3.5rem 0 3rem;
    overflow: hidden;
  }
  /* Subtle dot grid backdrop */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 20%, transparent 75%);
    opacity: 0.7;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .hero {
      padding: 6rem 0 4.5rem;
    }
  }
  .grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1180px) {
    .grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 3rem;
    }
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(2.6); opacity: 0; }
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.2rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .headline {
    margin-top: 1rem;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    font-weight: 600;
    color: var(--text);
    text-wrap: balance;
  }
  .tagline {
    margin-top: 0.85rem;
    max-width: 34rem;
    font-size: 1.08rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .actions .btn {
    padding-inline: 0.95rem;
  }
  @media (max-width: 420px) {
    .actions {
      gap: 0.4rem;
    }
    .actions .btn {
      padding-inline: 0.8rem;
    }
    .btn--icon {
      width: 2.85rem;
      padding: 0;
      justify-content: center;
    }
    .btn--icon .lbl {
      display: none;
    }
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--subtle);
  }
  .loc :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  /* IDE card: always dark, like an editor */
  .ide {
    display: none;
    margin: 0;
    border-radius: var(--radius);
    background: #0f1512;
    border: 1px solid #26312b;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }
  @media (min-width: 1180px) {
    .ide {
      display: block;
    }
  }
  .ide-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 0.9rem;
    background: #151d19;
    border-bottom: 1px solid #26312b;
  }
  .dots {
    display: flex;
    gap: 0.4rem;
  }
  .dots i {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #2f3c35;
  }
  .tab {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: #c9d6cf;
    padding: 0.15rem 0.6rem;
    border-radius: 6px;
    background: #0f1512;
    border: 1px solid #26312b;
  }
  .code {
    margin: 0;
    padding: 1.2rem 1rem 1.4rem 0.3rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.75;
    color: #d7e2dc;
    overflow-x: auto;
  }
  .ln {
    display: inline-block;
    width: 1.6rem;
    margin-right: 0.8rem;
    text-align: right;
    color: #7a8c82;
    user-select: none;
  }
  .kw { color: #f0a868; }
  .ty { color: #8cc8ff; }
  .st { color: #3ddc84; }
  .fn { color: #e5c07b; }

  /* Metrics strip */
  .metrics {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .metrics li {
    padding: 1.15rem 1.25rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .metrics li:nth-child(2n) { border-right: 0; }
  .metrics li:nth-last-child(-n + 2) { border-bottom: 0; }
  @media (min-width: 860px) {
    .metrics li:nth-child(n) { border-bottom: 0; border-right: 1px solid var(--border); }
    .metrics li:last-child { border-right: 0; }
  }
  .m-value {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .m-label {
    margin-top: 0.15rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
