---
import { projects } from '../data/profile';
---
<section id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <h2 id="projects-title">More projects</h2>
    {projects.map((p) => (
      <article class="project">
        <h3>{p.title}</h3>
        <p class="muted small context">{p.context}</p>
        {p.stat && <p><strong>{p.stat.value} {p.stat.label}.</strong></p>}
        <p>{p.description}</p>
        {p.points && (
          <ul>
            {p.points.map((pt) => <li>{pt}</li>)}
          </ul>
        )}
        <p class="small muted">
          {p.tech.join(', ')}
          {p.link && <> · <a href={p.link.href} rel="noopener noreferrer">{p.link.label}<span class="visually-hidden">: {p.title}</span></a></>}
        </p>
      </article>
    ))}
  </div>
</section>

<style>
  .project {
    margin-bottom: 2.25rem;
  }
  .context {
    margin-bottom: 0.6rem;
  }
</style>
