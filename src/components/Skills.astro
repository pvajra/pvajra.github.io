---
import { skills } from '../data/profile';
---
<section id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <h2 id="skills-title">Skills</h2>
    <dl>
      {skills.map((g) => (
        <div class="row">
          <dt>{g.group}</dt>
          <dd>{g.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  dl {
    margin: 0;
  }
  .row {
    display: grid;
    gap: 0.1rem 1.5rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .row:last-child {
    border-bottom: 0;
  }
  @media (min-width: 600px) {
    .row {
      grid-template-columns: 11rem 1fr;
    }
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
</style>
