---
import { skills } from '../data/profile';
---
<section id="skills" aria-labelledby="skills-title">
  <h2 id="skills-title">Skills</h2>
  <div class="groups">
    {skills.map((g) => (
      <div class="group">
        <h3>{g.group}</h3>
        <ul class="chips">
          {g.items.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: 1.5rem 2rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 760px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    font-size: 0.92rem;
    margin-bottom: 0.6rem;
  }
</style>
