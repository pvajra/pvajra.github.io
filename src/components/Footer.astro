---
import { person } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="wrap">
  <p>© {year} {person.fullName}. Built with Astro and hosted on GitHub Pages.</p>
</footer>

<style>
  footer {
    padding-top: 2rem;
    padding-bottom: 3rem;
    background: linear-gradient(var(--rule), var(--rule)) no-repeat top / calc(100% - 2.5rem) 1px;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
