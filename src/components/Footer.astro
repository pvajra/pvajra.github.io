---
import { person } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container row">
    <p>© {year} {person.fullName}</p>
    <a href="#top">Back to top</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
</style>
