---
import { person } from '../data/profile';
const year = new Date().getFullYear();
---
<footer>
  <p>© {year} {person.fullName}. Built with Astro and hosted on GitHub Pages.</p>
</footer>

<style>
  footer {
    padding-top: 2rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
