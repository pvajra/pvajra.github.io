---
import { featured } from '../data/profile';

// Small process diagrams for each deployment architecture.
const diagrams: Record<string, { boxes: string[]; link?: string; extra?: string }> = {
  C1: { boxes: ['App process', 'Agent + model'] },
  C2: { boxes: ['App process', 'Agent + model'], extra: 'checkpoint.json' },
  C3: { boxes: ['App', 'Foreground service'], link: 'AIDL / Binder' },
};
---
<section id="research" class="section lab" aria-labelledby="research-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow"><span class="num">03</span> Featured research · {featured.label}</span>
      <h2 id="research-title" class="section-title">{featured.title}</h2>
      <p class="lead">{featured.fullTitle}</p>
    </div>

    <ul class="stats" aria-label="Headline results">
      {featured.stats.map((s) => (
        <li class="stat">
          <p class="stat-value">{s.value}</p>
          <p class="stat-label">{s.label}</p>
          <p class="stat-detail">{s.detail}</p>
        </li>
      ))}
    </ul>

    <div class="cols">
      <div class="panel">
        <h3>The problem</h3>
        <p>{featured.problem}</p>
      </div>
      <div class="panel">
        <h3>Test setup</h3>
        <dl class="setup">
          {featured.setup.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <h3 class="sub-title">Three deployment architectures</h3>
    <ul class="archs">
      {featured.architectures.map((a) => {
        const d = diagrams[a.id];
        return (
          <li class="arch">
            <div class="arch-head">
              <span class="arch-id">{a.id}</span>
              <h4>{a.name}</h4>
            </div>
            <div class="diagram" aria-hidden="true">
              <span class="box">{d.boxes[0]}</span>
              {d.link ? <span class="link">{d.link}</span> : <span class="link plain"></span>}
              <span class="box box--accent">{d.boxes[1]}</span>
              {d.extra && <span class="file">↳ {d.extra}</span>}
            </div>
            <p class="how">{a.how}</p>
            <p class="recovery"><span>Recovery</span> {a.recovery}</p>
          </li>
        );
      })}
    </ul>

    <div class="panel findings">
      <h3>What I found</h3>
      <ul class="bullets">
        {featured.findings.map((f) => <li>{f}</li>)}
      </ul>
    </div>

    <ul class="chips chips--small tech" aria-label="Technologies">
      {featured.tech.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Always-dark "device lab" panel, independent of the page theme */
  .lab {
    --l-bg: #0b120e;
    --l-surface: #111a15;
    --l-border: #233029;
    --l-text: #e8eeea;
    --l-muted: #a7b5ad;
    --l-accent: #3ddc84;
    /* Re-point the global tokens so shared styles (eyebrow, lead, chips, bullets, focus) adapt */
    --accent: var(--l-accent);
    --accent-soft: #12301f;
    --text: var(--l-text);
    --muted: var(--l-muted);
    --subtle: var(--l-muted);
    --border: var(--l-border);
    --surface-2: var(--l-surface);
    background: var(--l-bg);
    color: var(--l-text);
    border-top-color: var(--l-border);
    color-scheme: dark;
  }

  :global([data-theme='dark']) .lab {
    --l-bg: #070b09;
  }
  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 860px) {
    .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .stat,
  .panel,
  .arch {
    background: var(--l-surface);
    border: 1px solid var(--l-border);
    border-radius: var(--radius);
  }
  .stat {
    padding: 1.2rem 1.2rem 1.3rem;
  }
  .stat-value {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--l-accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-weight: 600;
    margin-top: 0.3rem;
  }
  .stat-detail {
    font-size: 0.84rem;
    color: var(--l-muted);
    margin-top: 0.3rem;
    line-height: 1.45;
  }
  .cols {
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 860px) {
    .cols { grid-template-columns: 1fr 1fr; }
  }
  .panel {
    padding: 1.4rem;
    color: var(--l-muted);
  }
  h3 {
    font-size: 1rem;
    color: var(--l-text);
    margin-bottom: 0.75rem;
  }
  .sub-title {
    margin-bottom: 1rem;
  }
  .setup {
    display: grid;
    gap: 0.7rem;
  }
  .setup div {
    display: grid;
    gap: 0.1rem;
  }
  @media (min-width: 480px) {
    .setup div { grid-template-columns: 6rem 1fr; gap: 1rem; }
  }
  dt {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--l-accent);
    padding-top: 0.2rem;
  }
  .archs {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 860px) {
    .archs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .arch {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.3rem;
  }
  .arch-head {
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }
  .arch-id {
    flex-shrink: 0;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.8rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: #12301f;
    color: var(--l-accent);
  }
  h4 {
    font-size: 0.98rem;
    color: var(--l-text);
  }
  .diagram {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem;
    border-radius: 10px;
    background: #0b120e;
    border: 1px dashed var(--l-border);
    font-family: var(--mono);
    font-size: 0.7rem;
  }
  .box {
    padding: 0.45rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--l-border);
    text-align: center;
    color: var(--l-text);
    line-height: 1.3;
  }
  .box--accent {
    border-color: #2a7a50;
    background: #12301f;
  }
  .link {
    font-size: 0.62rem;
    color: var(--l-muted);
    text-align: center;
    line-height: 1.2;
    padding: 0 0.1rem;
    max-width: 4.5rem;
  }
  .link::before,
  .link::after {
    content: '';
    display: block;
    height: 1px;
    background: var(--l-muted);
    margin: 0.25rem 0;
  }
  .link.plain {
    width: 1.25rem;
  }
  .link.plain::after {
    display: none;
  }
  .file {
    grid-column: 3;
    font-size: 0.68rem;
    color: var(--l-accent);
    text-align: center;
  }
  .how {
    color: var(--l-muted);
    font-size: 0.93rem;
  }
  .recovery {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--l-border);
    font-size: 0.88rem;
  }
  .recovery span {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--l-muted);
    margin-right: 0.4rem;
  }
  .findings {
    margin-bottom: 1.5rem;
  }
</style>
