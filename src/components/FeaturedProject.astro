---
import { featured } from '../data/profile';
---
<section id="research" aria-labelledby="research-title">
  <div class="wrap">
    <h2 id="research-title">Featured project: {featured.title}</h2>
    <p class="muted">{featured.label}. {featured.fullTitle}.</p>

    <dl class="numbers">
      {featured.stats.map((s) => (
        <div>
          <dt>{s.value}</dt>
          <dd><span class="label">{s.label}</span> <span class="muted small">{s.detail}</span></dd>
        </div>
      ))}
    </dl>

    <h3>The problem</h3>
    <p>{featured.problem}</p>

    <h3>Setup</h3>
    <ul>
      {featured.setup.map((s) => <li><strong>{s.label}:</strong> {s.value}</li>)}
    </ul>

    <h3>Three deployment architectures</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col"></th><th scope="col">How it runs</th><th scope="col">Recovery</th></tr>
        </thead>
        <tbody>
          {featured.architectures.map((a) => (
            <tr>
              <th scope="row">{a.id}</th>
              <td><strong>{a.name}.</strong> {a.how}</td>
              <td>{a.recovery}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>What I found</h3>
    <ul>
      {featured.findings.map((f) => <li>{f}</li>)}
    </ul>
    <p class="small muted">{featured.tech.join(', ')}</p>
  </div>
</section>

<style>
  h3 {
    margin: 1.75rem 0 0.6rem;
  }
  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    margin: 2rem 0 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    .numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  dt {
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  dd {
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }
  .label {
    display: block;
    font-weight: 550;
  }
  .small {
    display: block;
    margin-top: 0.15rem;
  }
  th[scope='row'] {
    white-space: nowrap;
    padding-right: 1rem;
  }
</style>
