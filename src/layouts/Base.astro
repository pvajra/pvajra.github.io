---
import '../styles/global.css';
import { site, person } from '../data/profile';

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.fullName,
  alternateName: person.name,
  jobTitle: 'Android Software Engineer',
  url: site.url,
  email: `mailto:${person.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Newcastle upon Tyne', addressCountry: 'GB' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Newcastle University' },
    { '@type': 'CollegeOrUniversity', name: 'KLS Gogte Institute of Technology' },
  ],
  sameAs: [person.linkedin, person.github],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={person.fullName} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161817" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.headline}`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Set the theme before first paint to avoid a flash of the wrong theme -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
